    "fileSets": [
        {
            "name": "Project files",
            "files": [
                "dsPIC33CH_TCP_Lite.X/Makefile",
                "dsPIC33CH_TCP_Lite.X/mcc_generated_files/spi_host/**/*",
                "dsPIC33CH_TCP_Lite.X/mcc_generated_files/system/**/*",
